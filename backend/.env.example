# Database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/aisupport"

# JWT
JWT_SECRET="generate-a-random-64-char-hex-string"
JWT_EXPIRES_IN="7d"

# Redis
REDIS_URL="redis://localhost:6379"

# AI Services URL
AI_URL="http://localhost:8000"

# Server Port
PORT=5000

# Email Notifications (Gmail App Password)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"
AGENT_EMAIL="agent-email@gmail.com"

# CORS (comma-separated origins, optional — defaults to localhost:5173,3000)
# CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
